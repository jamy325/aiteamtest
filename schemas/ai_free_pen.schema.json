{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ai_free_pen.schema.json",
  "title": "AI Free Pen Response",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "coordinate_space", "segments", "reason"],
      "properties": {
        "decision": { "const": "draw" },
        "coordinate_space": { "const": "image_px" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bezier_segment" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "const": "accept" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "const": "stalled" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "$defs": {
    "point2d": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "bezier_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0", "c1", "c2", "p1"],
      "properties": {
        "p0": { "$ref": "#/$defs/point2d" },
        "c1": { "$ref": "#/$defs/point2d" },
        "c2": { "$ref": "#/$defs/point2d" },
        "p1": { "$ref": "#/$defs/point2d" }
      }
    }
  }
}
